{
  "name": "ocproxy",
  "version": "1.0.1",
  "description": "OCProxy — OpenCode Zen free-model relay: multi-format downstream API, fingerprinted OpenAI-compatible upstream, free-only model catalog.",
  "type": "module",
  "main": "src/index.ts",
  "module": "src/index.ts",
  "bin": {
    "OCProxy": "bin/ocproxy.mjs",
    "ocproxy": "bin/ocproxy.mjs"
  },
  "files": [
