# OCProxy — example environment.
# Copy to .env (Bun loads it automatically) or export the variables yourself.

# Listen address / port.
HOST=0.0.0.0
PORT=8787

# Upstream OpenAI-compatible endpoint and public model catalog.
UPSTREAM_BASE_URL=https://opencode.ai/inference/openai/v1
UPSTREAM_MODELS_URL=https://opencode.ai/inference/v1/models
# OpenCode Zen accepts the shared non-secret key "public" for anonymous use.
UPSTREAM_API_KEY=public

# Optional HTTP CONNECT proxy for upstream requests. Public free proxies are
# almost always dead or already flagged by Zen; use a trusted/residential proxy.
# Supports optional auth: http://user:pass@host:port
# UPSTREAM_PROXY=http://127.0.0.1:7890

# OpenCode identity impersonated on the wire.
OPENCODE_VERSION=2.2.6
# OPENCODE_USER_AGENT=opencode/latest/2.2.6/cli
OPENCODE_CLIENT=cli
# Directory used to derive the project id and the minimal <env> block.
# OPENCODE_WORKING_DIRECTORY=E:\ZenFreeProxy
# Override the derived project id (sha1("directory:<dir>")).
# OPENCODE_PROJECT_ID=

# Zen's v2 gate (measured 2026-11-08) only needs a complete <env> block with a
# "Working directory:" line and one tool named exactly `read`. Both are injected
# unconditionally; there are no mode switches.
# Reject oversized prompts locally with a clear 400 before spending the free
# token bucket or surfacing a raw provider context error.
CONTEXT_GUARD=true
# On upstream 429, retry exactly once with a brand-new session id (default on).
# Set false if your quota is truly exhausted and you want to avoid extra requests.
RETRY_ON_429=true
# Per-model limit corrections (JSON). No model data is hardcoded; the relay
# uses the live catalog's limits unless you override a specific id here.
# CONTEXT_LIMIT_OVERRIDES={"some-model":{"context":123456}}

# Model-catalog cache lifetime (ms) and the shorter retry window after failure.
MODEL_CACHE_TTL_MS=600000
MODEL_CACHE_ERROR_TTL_MS=30000

# Reject requests for models that are not free (recommended).
FREE_MODELS_ONLY=true

# Ask upstream for a final usage chunk (stream_options.include_usage).
# OpenCode always sends this; keep it on to match its wire format.
UPSTREAM_INCLUDE_USAGE=true

# Max completion tokens added when the caller specified none (OpenCode sends 32000).
OPENCODE_MAX_COMPLETION_TOKENS=32000

# Session affinity: "auto" reuses a genuine inbound OpenCode session id,
# otherwise derives one per conversation; "off" mints a new session per request.
SESSION_AFFINITY=auto

# Per-request upstream timeout (ms).
REQUEST_TIMEOUT_MS=300000

# Safety: never contact opencode.ai. Serves a synthetic reply (the catalog stays
# empty because no model data is hardcoded), so downstream client formats can be
# tested without burning the current egress IP's free quota.
# UPSTREAM_DRY_RUN=1

# Optional: comma separated list of extra free model ids to expose.
# EXTRA_FREE_MODELS=

# Log level: debug / info / warn / error.
LOG_LEVEL=info

